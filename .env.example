# Nunca coloque valores reais neste arquivo ou no GitHub.

# PostgreSQL. Sem esta variável o servidor usa um arquivo JSON em .data/ (apenas desenvolvimento).
DATABASE_URL=

# Senha de acesso ao ambiente. Vazia = acesso aberto (use somente em rede local).
MAPA_ACCESS_PASSWORD=

# Segredo aleatório (mínimo 32 caracteres) para assinar a sessão quando a senha está ativa.
MAPA_SESSION_SECRET=

PORT=8080
